// Campus Connect Database Schema — PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(STUDENT)
  studentId    String?  @unique // Format: 5900XXXXX with strict validity checks
  department   String?
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  complaints      Complaint[]     @relation("StudentComplaints")
  statusHistories StatusHistory[] @relation("ChangedByUser")
  comments        Comment[]
  notifications   Notification[]

  @@index([role])
  @@index([studentId])
}

model Department {
  id           String      @id @default(uuid())
  name         String      @unique
  code         String      @unique
  description  String?
  contactEmail String?
  headName     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  complaints   Complaint[]
}

model Complaint {
  id                  String    @id @default(uuid())
  referenceId         String    @unique // Format: CC-2025-XXXXX
  title               String
  description         String
  category            String
  location            String
  priority            Priority  @default(MEDIUM)
  status              Status    @default(SUBMITTED)
  rejectionReason     String?
  reopenReason        String?
  assignedStaffName   String?
  resolutionNotes     String?
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  studentId           String
  student             User        @relation("StudentComplaints", fields: [studentId], references: [id], onDelete: Cascade)

  assignedDepartmentId String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id])

  statusHistory       StatusHistory[]
  comments            Comment[]
  attachments         Attachment[]
  notifications       Notification[]

  @@index([studentId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
}

model StatusHistory {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus  Status?
  toStatus    Status
  changedById String
  changedBy   User      @relation("ChangedByUser", fields: [changedById], references: [id])
  note        String?
  createdAt   DateTime  @default(now())

  @@index([complaintId])
  @@index([createdAt])
}

model Comment {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

model Attachment {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime  @default(now())

  @@index([complaintId])
}

model Notification {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String     @default("STATUS_CHANGE") // SUBMISSION, STATUS_CHANGE, ASSIGNED, COMMENT, RESOLUTION
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([isRead])
}
