# ========================================================
# Campus Connect — Environment Configuration Example
# Copy this file to .env in your root or server directory
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_connect?schema=public"

# Authentication & Security
JWT_SECRET="campus-connect-dev-secret-key-replace-in-production-32bytes"
JWT_EXPIRES_IN="7d"

# CORS & Client Origin
CLIENT_URL="http://localhost:5173"

# Demo Mode
# If true or if PostgreSQL is unreachable, the system operates in resilient Demo Mode
# with rich pre-seeded mock campus data.
DEMO_MODE=true
